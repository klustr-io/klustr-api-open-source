{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LoadBalancerBackendSwitchingRule",
  "description": "A rule associating a backend to a specific switching rule.",
  "type": "object",
  "properties": {
    "cond": {
      "type": "string",
      "description": "if",
      "default": "if",
      "examples": ["if"]
    },
    "cond_test": {
      "type": "string",
      "description": "The ACL to test",
      "examples": [
        "is_my_project"
      ]
    },
    "name": {
      "type": "string",
      "description": "The name of the backend",
      "examples": [
        "your_backend"
      ]
    }
  },
  "required": []
}