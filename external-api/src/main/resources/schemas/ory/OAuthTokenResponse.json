{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "title": "OAuthTokenResponse",
  "properties": {
    "active": {
      "type": "boolean"
    },
    "scope": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "sub": {
      "type": "string"
    },
    "exp": {
      "type": "integer"
    },
    "iat": {
      "type": "integer"
    },
    "nbf": {
      "type": "integer"
    },
    "aud": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "The audiences targeted for this token."
      }
    },
    "iss": {
      "type": "string",
      "description": "The issuer of this token"
    },
    "token_type": {
      "type": "string",
      "description": "The type of token being issued."
    },
    "token_use": {
      "type": "string",
      "description": "The use for this token."
    },
    "ext": {
      "type": "object",
      "description": "Extension information regarding the token which is free form.",
      "additionalProperties": true,
      "additionalItems": true
    }
  }
}