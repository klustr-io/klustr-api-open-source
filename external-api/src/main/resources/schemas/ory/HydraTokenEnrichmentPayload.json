{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "title": "HydraTokenEnrichmentPayload",
  "description": "A mapping to the hydra webhook enrichment process. This does not contain all properties only a select few used for the purposes of group and enrichment.",
  "properties": {
    "session": {
      "title": "HydraTokenEnrichmentPayloadSession",
      "type": "object",
      "properties": {
        "id_token": {
          "type": "object",
          "title": "HydraIdToken",
          "properties": {
            "subject": {
              "type": "string",
              "description": "The real subject ID and is not impacted by pairwise ID"
            },
            "id_token_claims": {
              "type": "object",
              "title": "HydraIdTokenClaims",
              "properties": {
                "iss": {
                  "type": "string"
                },
                "sub": {
                  "type": "string",
                  "description": "Will contain the public OR pairwise subject identifer userful for mapping PPID to real ID."
                },
                "aud": {
                  "type": "array",
                  "items": [
                    {
                      "type": "string"
                    }
                  ]
                },
                "ext": {
                  "type": "object",
                  "title": "HydraIdTokenExt",
                  "properties": {
                    "email": {
                      "type": "string"
                    },
                    "family_name": {
                      "type": "string"
                    },
                    "given_name": {
                      "type": "string"
                    },
                    "locale": {
                      "type": "string"
                    },
                    "picture": {
                      "type": "string"
                    },
                    "sid": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "client_id": {
          "type": "string"
        },
        "consent_challenge": {
          "type": "string"
        }
      }
    },
    "request": {
      "type": "object",
      "title": "HydraTokenEnrichmentPayloadRequest",
      "properties": {
        "client_id": {
          "type": "string"
        },
        "granted_scopes": {
          "type": "array",
          "description": "Granted scopes",
          "items": {
            "type": "string"
          }
        },
        "granted_audience": {
          "type": "array",
          "description": "Granted scopes",
          "items": {
            "type": "string"
          }
        },
        "grant_types": {
          "type": "array",
          "description": "Granted scopes",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}