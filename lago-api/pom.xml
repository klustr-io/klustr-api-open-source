            <plugin>
                <artifactId>maven-clean-plugin</artifactId>
                <version>3.3.2</version>
                <executions>
                    <execution>
                        <id>auto-clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                        <configuration>
                            <filesets>
                                <fileset>
                                    <directory>${project.build.directory}</directory>
                                </fileset>
                                <fileset>
                                    <directory>${basedir}/src/main/java</directory>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <version>7.9.0</version>
                <executions>
                    <execution>
                        <id>generate-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>
                                ${project.basedir}/src/main/resources/lago-openapi.yaml
                            </inputSpec>
                            <modelNamePrefix>Lago</modelNamePrefix>

                            <generatorName>java</generatorName>
                            <skipValidateSpec>true</skipValidateSpec>
                            <generateApiTests>false</generateApiTests>
                            <generateApiDocumentation>false</generateApiDocumentation>
                            <generateApiTests>false</generateApiTests>
                            <generateModelTests>false</generateModelTests>

                            <additionalProperties>
                                <javaValidation>false</javaValidation>
                            </additionalProperties>

                            <configOptions>
                                <dateLibrary>legacy</dateLibrary>
                                <javaValidation>false</javaValidation>
                                <sourceFolder>src/main/java</sourceFolder>
                                <useJakartaEe>true</useJakartaEe>
                                <library>okhttp-gson</library>
                                <annotationLibrary>swagger2</annotationLibrary>
                                <documentationProvider>none</documentationProvider>
                                <interfaceOnly>true</interfaceOnly>
                                <generatePom>false</generatePom>
                                <disallowAdditionalPropertiesIfNotPresent>false</disallowAdditionalPropertiesIfNotPresent>

                                <basePackage>com.lago.openapi</basePackage>
                                <modelPackage>com.lago.openapi.model</modelPackage>
                                <apiPackage>com.lago.openapi.api</apiPackage>
                                <invokerPackage>com.lago.openapi.client</invokerPackage>

                                <additionalModelTypeAnnotations>@com.fasterxml.jackson.annotation.JsonIgnoreProperties(ignoreUnknown = true)</additionalModelTypeAnnotations>
                                <useBeanValidation>false</useBeanValidation>
                            </configOptions>

                        </configuration>
                    </execution>
                </executions>
            </plugin>

