{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "title": "IdentityCredentials",
  "description": "The online persona and profile for a specific identity.",
  "properties": {
      "oidc": {
        "type": "object",
        "title": "IdentityOidcCredential",
        "properties": {
          "type": {
            "type": "string"
          },
          "identifiers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "password": {
        "type": "object",
        "title": "IdentityPasswordCredential",
        "properties": {
          "type": {
            "type": "string"
          },
          "config": {
            "type": "object",
            "title": "IdentityPasswordCredentialConfig",
            "description": "The password configuration containing the users password.",
            "properties": {
              "password": {
                "type": "string",
                "description": "The password to configure for the user."
              }
            }
          }
        }
      }
  }
}