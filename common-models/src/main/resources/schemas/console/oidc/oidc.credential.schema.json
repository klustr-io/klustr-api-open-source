{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "OIDCCredential",
  "description": "A client that is a basic credential flow for authentication.",
  "type": "object",
  "properties": {
    "name": {
      "description": "The name of this client credential.",
      "type": "string"
    },
    "client_id": {
      "description": "The unique ID for this client.",
      "type": "string"
    },
    "secret_key": {
      "description": "The secret key for this client",
      "type": "string"
    },
    "access_token_strategy": {
      "$ref": "oidc.enums.json#/definitions/access_token_strategy"
    },
    "token_endpoint_auth_method": {
      "$ref": "oidc.enums.json#/definitions/token_endpoint_auth_method"
    },
    "creation_date": {
      "description": "The date this client was created.",
      "type": "string",
      "format": "date-time"
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "existingJavaType": "java.util.Set<String>",
      "examples": [
        "spiffe://staging.example.com/payments/web-fe",
        "spiffe://example.com/9eebccd2-12bf-40a6-b262-65fe0487d453",
        "my_service_xyz"
      ]
    },
    "status": {
      "description": "The status of this client",
      "title": "OidcStatus",
      "enum": [
        "enabled",
        "deleted"
      ]
    },
    "metadata": {
      "type": "object",
      "description": "Additional metadata related to the client to tag or otherwise manage it.",
      "existingJavaType": "java.util.Map<String,String>"
    }
  },
  "required": [
    "client_id",
    "secret_key"
  ]
}