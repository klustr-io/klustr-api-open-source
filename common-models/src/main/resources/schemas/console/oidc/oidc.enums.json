{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "definitions": {
    "access_token_strategy": {
      "enum": [
        "jwt",
        "opaque"
      ],
      "description": "The method for how a token is generated, opaque is preferred for security and requires introspection.",
      "type": "string",
      "default": "opaque",
      "javaType": "io.klustr.schemas.console.AccessTokenStrategy"
    },
    "token_endpoint_auth_method": {
      "description": "The strategy for the token",
      "type": "string",
      "enum": [
        "client_secret_basic",
        "client_secret_post",
        "private_key_jwt"
      ],
      "default": "client_secret_basic",
      "javaType": "io.klustr.schemas.console.TokenEndpointAuthMethod"
    },
    "subject_type": {
      "description": "Activates pseudo anonymous identifiers when set to pairwise",
      "type": "string",
      "enum": [
        "pairwise",
        "public"
      ],
      "javaType": "io.klustr.schemas.console.SubjectType"
    }
  }
}