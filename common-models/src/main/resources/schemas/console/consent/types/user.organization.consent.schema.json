{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UserOrganizationConsent",
  "type": "object",
  "allOf": [{ "$ref": "../user.consent.schema.json" }],
  "extendsJavaClass" : "io.klustr.schemas.console.consent.UserConsent",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "The organization that the user has accepted."
    },
    "first_seen_date": {
      "description": "The first consent date this experiment was last consented to.",
      "type": "string",
      "format": "date-time"
    },
    "last_seen_date": {
      "description": "The last consent date this experiment was last consented to.",
      "type": "string",
      "format": "date-time"
    },
    "type": {
      "description": "The type of consent granted.",
      "type": "string",
      "enum": ["explicit", "implicit"]
    },
    "status": {
      "description": "The status of this specific experiment consent.",
      "type": "string",
      "enum": ["active", "revoked", "expired"]
    }
  },
  "additionalProperties": false
}