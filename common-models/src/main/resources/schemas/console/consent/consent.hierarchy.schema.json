{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UserConsentHierarchy",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "The unique application identifier."
    },
    "empty": {
      "type": "boolean",
      "description": "No consent on file."
    },
    "orgs": {
      "type": "array",
      "description": "The organizations the user has made consent agreements with.",
      "items": {
        "type": "object",
        "title": "UserOrganizationConsentHierarchy",
        "properties": {
          "org_id": {
            "type": "string",
            "description": "The organization ID"
          },
          "org_name": {
            "type": "string",
            "description": "The organization name"
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "object",
              "$ref": "./user.consent.scope.schema.json"
            }
          },
          "apps": {
            "type": "array",
            "description": "Application level consent that user has within the organization.",
            "items": {
              "type": "object",
              "title": "UserApplicationConsentHierarchy",
              "properties": {
                "app_id": {
                  "type": "string",
                  "description": "The application identifier for this consent."
                },
                "app_name": {
                  "type": "string",
                  "description": "The application name"
                },
                "app_logo": {
                  "type": "string",
                  "description": "The application logo",
                  "format": "uri",
                  "pattern": "^https?://"
                },
                "scopes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "$ref": "./user.consent.scope.schema.json"
                  }
                },
                "experiments": {
                  "type": "array",
                  "description": "Experiment level consent",
                  "items": {
                    "type": "object",
                    "title": "UserExperimentConsentHierarchy",
                    "properties": {
                      "experiment_id": {
                        "type": "string",
                        "description": "The experiment identifier for this consent."
                      },
                      "experiment_name": {
                        "type": "string",
                        "description": "The application name"
                      },
                      "scopes": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "$ref": "./user.consent.scope.schema.json"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "agreements": {
            "type": "array",
            "description": "Consent granted to users through agreements signed.",
            "items": {
              "type": "object",
              "title": "UserAgreementConsentHierarchy",
              "properties": {
                "agreement_id": {
                  "type": "string",
                  "description": "The agreement identifier."
                },
                "agreement_name": {
                  "type": "string",
                  "description": "The agreement name."
                },
                "scopes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "$ref": "./user.consent.scope.schema.json"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}