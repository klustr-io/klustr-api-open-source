        "$ref": "./location.event.schema.json"
      }
    },
    "week": {
      "description": "A summarized version of history for the past week for the user.",
      "type": "array",
      "items": {
        "type": "object",
        "$ref": "./location.event.schema.json"
      }
    },
    "month": {
