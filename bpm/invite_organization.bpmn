    <bpmn:textAnnotation id="TextAnnotation_12qt27p">
      <bpmn:text>Get authentication so we can invoke the email send using our OIDC client credentials. v1</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_08f7guh" sourceRef="Activity_0p2ek2m" targetRef="TextAnnotation_12qt27p" />
    <bpmn:textAnnotation id="TextAnnotation_0itqn4w">
      <bpmn:text>API exposed to send emails (templates are hosted in mailtrap)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0x3qytu" sourceRef="Activity_1ynbm6v" targetRef="TextAnnotation_0itqn4w" />
    <bpmn:textAnnotation id="TextAnnotation_10izwje">
      <bpmn:text>Kafka queue that contains invite messages we can delivery notifications and do business logic checks.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1dtnu8o">
      <bpmn:text>Let the person who invited know the other party accepted the invite. Also functions as a security check.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1rllhhm" sourceRef="TextAnnotation_1dtnu8o" targetRef="Activity_1lop1ar" />
    <bpmn:textAnnotation id="TextAnnotation_18w9gt3">
      <bpmn:text>Poll kafka for anything not pending so we can process a complete the operation.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0gi5esn" associationDirection="None" sourceRef="TextAnnotation_18w9gt3" targetRef="Event_1n04u88" />
    <bpmn:association id="Association_056ggau" sourceRef="TextAnnotation_10izwje" targetRef="Event_037sbmi" />
    <bpmn:textAnnotation id="TextAnnotation_19ctyi7">
      <bpmn:text>Waiting could be delayed by days, so we need to refresh our token as the old one is likely expired.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0p1x1sb" associationDirection="None" sourceRef="TextAnnotation_19ctyi7" targetRef="Activity_04qfdgc" />
    <bpmn:textAnnotation id="TextAnnotation_096afxa">
      <bpmn:text>Version 1.0.1</bpmn:text>
    </bpmn:textAnnotation>
