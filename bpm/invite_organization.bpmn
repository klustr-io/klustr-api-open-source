          <zeebe:property name="topic.bootstrapServers" value="kafka.dev.klustr.io:9092" />
          <zeebe:property name="topic.topicName" value="invites" />
          <zeebe:property name="groupId" value="camunda_invite_pending_listener" />
          <zeebe:property name="autoOffsetReset" value="earliest" />
          <zeebe:property name="schemaStrategy.type" value="noSchema" />
          <zeebe:property name="activationCondition" value="=value.status = &#34;pending&#34;" />
          <zeebe:property name="consumeUnmatchedEvents" value="true" />
          <zeebe:property name="correlationRequired" value="required" />
          <zeebe:property name="correlationKeyExpression" value="=value.id" />
          <zeebe:property name="deduplicationModeManualFlag" value="false" />
          <zeebe:property name="deduplicationMode" value="AUTO" />
          <zeebe:property name="resultVariable" value="payload" />
