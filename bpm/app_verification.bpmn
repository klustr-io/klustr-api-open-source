    <bpmn:userTask id="Activity_0x1njct" name="Decide if Verified">
      <bpmn:documentation>Its up to the user to decide if an application is verified or rejected.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:properties />
        <zeebe:formDefinition formId="app_verification_form" />
        <zeebe:taskSchedule dueDate="= now() + duration(&#34;PT1H&#34;)" followUpDate="= now() + duration(&#34;PT2H&#34;)" />
        <zeebe:ioMapping>
          <zeebe:input source="=requestor" target="requestor" />
          <zeebe:input source="=project.id" target="project_id" />
          <zeebe:input source="=project.name" target="project_name" />
          <zeebe:input source="=project.app.brand" target="brand" />
          <zeebe:input source="=project" target="project" />
          <zeebe:input source="=project.app.brand.logo.url" target="brand_logo" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
